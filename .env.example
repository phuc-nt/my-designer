# my-designer — bootstrap.mjs writes the real .env.local for you. This file only
# documents the knobs. All optional except ENCRYPTION_KEY.

# 32 random bytes, base64. Generated once by bootstrap. Never rotate: stored
# provider keys are encrypted with it.
ENCRYPTION_KEY=

PORT=8787
HOST=127.0.0.1
APP_URL=http://localhost:8787
DATA_DIR=./data

# Local single-user mode. Any request that reaches the server acts as this
# person, so the server refuses to start unless HOST is loopback. Unset it to
# get the upstream email/password accounts back.
LOCAL_USER=You
ALLOW_REGISTRATION=false
COMMUNITY_ENABLED=false

# Optional: Google Fonts catalog search (`dsa fonts`).
GOOGLE_FONTS_API_KEY=

#!/usr/bin/env bash
# dsa wrapper for the local studio. The server runs in local single-user mode,
# so no token exists: any request from this machine is the owner. The CLI
# still insists on a non-empty key, so a placeholder is exported.
# Usage: bin/dsa projects list
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cli="$root/packages/cli/dist/dsa.js"
envfile="$root/.env.local"

if [ ! -f "$cli" ] || [ ! -f "$envfile" ]; then
  echo "bin/dsa: not set up — run: node bootstrap.mjs" >&2
  exit 1
fi

if [ -z "${DESIGN_STUDIO_URL:-}" ]; then
  app_url="$(grep -E '^APP_URL=' "$envfile" | head -1 | cut -d= -f2-)"
  port="$(grep -E '^PORT=' "$envfile" | head -1 | cut -d= -f2-)"
  DESIGN_STUDIO_URL="${app_url:-http://localhost:${port:-8787}}"
fi
export DESIGN_STUDIO_URL
export DESIGN_STUDIO_API_KEY="${DESIGN_STUDIO_API_KEY:-local}"

exec node "$cli" "$@"
